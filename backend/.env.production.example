# ==============================================================================
# SREE SAI KRISHNA COLLECTIONS (SSK) – PRODUCTION ENVIRONMENT TEMPLATE
# Instructions:
# 1. Copy this file to `backend/.env` on the production server.
# 2. Generate a secure 64-character secret with: `openssl rand -hex 32`
# 3. Enter your real MongoDB Atlas connection string, Razorpay live keys,
#    SMTP server credentials, and Meta WhatsApp Cloud API credentials.
# ==============================================================================

# 1. Core Application & Security
ENVIRONMENT=production
PROJECT_NAME="Sree Sai Krishna Collections API"
BRAND_NAME="Sree Sai Krishna Collections"
BRAND_SHORT_NAME="SSK"
SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32_GENERATED_SECRET
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# 2. Production Database (MongoDB Atlas Replica Set)
FORCE_MOCK_DB=false
MONGODB_URI=mongodb+srv://ssk_app_user:STRONG_SECURE_PASSWORD@ssk-cluster.xxxxxx.mongodb.net/ssk_collections_db?retryWrites=true&w=majority
DATABASE_NAME=ssk_collections_db
DB_MAX_POOL_SIZE=100
DB_MIN_POOL_SIZE=10
DB_MAX_IDLE_TIME_MS=45000
DB_SERVER_SELECTION_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT_MS=10000
DB_SOCKET_TIMEOUT_MS=20000
DB_TLS=true

# 3. CORS & Origin Whitelisting
BACKEND_CORS_ORIGINS=["https://sreesaikrishnacollections.com","https://www.sreesaikrishnacollections.com","https://admin.sreesaikrishnacollections.com"]
FRONTEND_URL="https://sreesaikrishnacollections.com"

# 4. Live Payment Gateway (Razorpay Live)
# CAUTION: Only activate live keys after merchant account KYC verification.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
ALLOW_MOCK_PAYMENTS=false
ENABLE_COD=true
COD_MIN_ORDER_AMOUNT=299.0
COD_MAX_ORDER_AMOUNT=50000.0
FREE_SHIPPING_THRESHOLD=999.0
STANDARD_SHIPPING_FEE=79.0

# 5. Store Business & Tax Details
SUPPORT_EMAIL="support@sreesaikrishnacollections.com"
SUPPORT_PHONE="+91 98480 22338"
BUSINESS_ADDRESS="Shop #12, Sri Krishna Temple Street, Near Clock Tower, Secunderabad, Telangana - 500003, India"
SELLER_GSTIN="36AAECS1234F1Z5"
SELLER_STATE="Telangana"
SELLER_STATE_CODE="36"
SELLER_PAN="AAECS1234F"
DEFAULT_JEWELLERY_GST_RATE=0.03
DEFAULT_ACCESSORIES_GST_RATE=0.18
INVOICE_PREFIX="SSK-INV"
CREDIT_NOTE_PREFIX="SSK-CN"

# 6. Transactional Email Gateway (AWS SES / SendGrid)
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=AKIAIOSFODNN7EXAMPLE
SMTP_PASSWORD=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
SMTP_FROM_EMAIL=orders@sreesaikrishnacollections.com
SMTP_FROM_NAME="Sree Sai Krishna Collections"
SMTP_TLS=true

# 7. Official Meta WhatsApp Business Platform Cloud API (v19.0)
WHATSAPP_ENABLED=true
WHATSAPP_PHONE_NUMBER_ID=109283746592837
WHATSAPP_BUSINESS_ACCOUNT_ID=982736451928374
WHATSAPP_ACCESS_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_API_VERSION="v19.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=ssk_meta_webhook_secure_token_2026
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 8. Courier Logistics
LOGISTICS_WEBHOOK_SECRET=ssk_logistics_webhook_secret_2026
