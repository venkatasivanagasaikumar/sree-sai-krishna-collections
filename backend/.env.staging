# ==============================================================================
# SREE SAI KRISHNA COLLECTIONS (SSK) – STAGING ENVIRONMENT CONFIGURATION
# ==============================================================================

ENVIRONMENT=staging
PROJECT_NAME="Sree Sai Krishna Collections API (Staging)"
BRAND_NAME="Sree Sai Krishna Collections"
BRAND_SHORT_NAME="SSK"
SECRET_KEY=ssk-staging-jwt-secret-key-64-bytes-super-secure-2026-simulation
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Staging Database:
# Ready to accept user-provided MongoDB Atlas connection string when provided.
# Will use local persistence until user explicitly supplies staging Atlas URI.
FORCE_MOCK_DB=false
MONGODB_URI=mongodb://mongodb-staging:27017
DATABASE_NAME=ssk_staging_db
DB_MAX_POOL_SIZE=50
DB_MIN_POOL_SIZE=5
DB_MAX_IDLE_TIME_MS=45000
DB_SERVER_SELECTION_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT_MS=10000
DB_SOCKET_TIMEOUT_MS=20000
DB_TLS=false

# CORS & Frontends
BACKEND_CORS_ORIGINS=["http://localhost:80","http://localhost:5173","http://localhost:3000","http://127.0.0.1:80","http://127.0.0.1:5173"]
FRONTEND_URL=http://localhost:80

# Payments (Razorpay Sandbox Only - Live keys prohibited in staging)
RAZORPAY_KEY_ID=rzp_test_SSKJewelleryDemo2026
RAZORPAY_KEY_SECRET=SSKTestSecretMockSignatureKey
RAZORPAY_WEBHOOK_SECRET=SSKWebhookSecret2026
ALLOW_MOCK_PAYMENTS=true
ENABLE_COD=true
COD_MIN_ORDER_AMOUNT=299.0
COD_MAX_ORDER_AMOUNT=50000.0
FREE_SHIPPING_THRESHOLD=999.0
STANDARD_SHIPPING_FEE=79.0

# Store Details
SUPPORT_EMAIL=staging-support@sreesaikrishnacollections.com
SUPPORT_PHONE=+91 98480 22338
BUSINESS_ADDRESS="Shop #12, Sri Krishna Temple Street, Near Clock Tower, Secunderabad, Telangana - 500003, India"
SELLER_GSTIN=36AAECS1234F1Z5
SELLER_STATE=Telangana
SELLER_STATE_CODE=36
SELLER_PAN=AAECS1234F
DEFAULT_JEWELLERY_GST_RATE=0.03
DEFAULT_ACCESSORIES_GST_RATE=0.18
INVOICE_PREFIX=SSK-STG-INV
CREDIT_NOTE_PREFIX=SSK-STG-CN

# Transactional Email (Simulation Mode - Real email sending disallowed without approval)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=staging-orders@sreesaikrishnacollections.com
SMTP_FROM_NAME="SSK Staging"
SMTP_TLS=true

# Meta WhatsApp Cloud API (Simulation Mode - Real sending disallowed without approval)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v19.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=ssk_staging_wa_verify_token_2026
WHATSAPP_APP_SECRET=
