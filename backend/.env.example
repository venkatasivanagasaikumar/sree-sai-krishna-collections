# ==============================================================================
# SREE SAI KRISHNA COLLECTIONS (SSK) – BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `backend/.env` and update with appropriate values.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Sree Sai Krishna Collections API"
BRAND_NAME="Sree Sai Krishna Collections"
BRAND_SHORT_NAME="SSK"
SECRET_KEY="ssk-royal-navy-gold-super-secure-jwt-secret-key-2026-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (Set FORCE_MOCK_DB=false for real MongoDB/Atlas)
FORCE_MOCK_DB=true
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="ssk_collections_db"
DB_MAX_POOL_SIZE=50
DB_MIN_POOL_SIZE=10
DB_MAX_IDLE_TIME_MS=45000
DB_SERVER_SELECTION_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT_MS=10000
DB_SOCKET_TIMEOUT_MS=20000
DB_TLS=false

# CORS & Frontend Origins (Comma-separated or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://sreesaikrishnacollections.com","https://admin.sreesaikrishnacollections.com"]
FRONTEND_URL="http://localhost:5173"

# Payment Gateway (Razorpay Sandbox by Default)
RAZORPAY_KEY_ID="rzp_test_SSKJewelleryDemo2026"
RAZORPAY_KEY_SECRET="SSKTestSecretMockSignatureKey"
RAZORPAY_WEBHOOK_SECRET="SSKWebhookSecret2026"
ALLOW_MOCK_PAYMENTS=true
ENABLE_COD=true
COD_MIN_ORDER_AMOUNT=299.0
COD_MAX_ORDER_AMOUNT=50000.0
FREE_SHIPPING_THRESHOLD=999.0
STANDARD_SHIPPING_FEE=79.0

# Business Details
SUPPORT_EMAIL="support@sreesaikrishnacollections.com"
SUPPORT_PHONE="+91 98480 22338"
BUSINESS_ADDRESS="Shop #12, Sri Krishna Temple Street, Near Clock Tower, Secunderabad, Telangana - 500003, India"

# GST & Invoicing Configuration
SELLER_GSTIN=""
SELLER_STATE="Telangana"
SELLER_STATE_CODE="36"
SELLER_PAN="AAECS1234F"
DEFAULT_JEWELLERY_GST_RATE=0.03
DEFAULT_ACCESSORIES_GST_RATE=0.18
INVOICE_PREFIX="SSK-INV"
CREDIT_NOTE_PREFIX="SSK-CN"

# Transactional Email (SMTP Gateway: AWS SES / SendGrid / Google Workspace)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="orders@sreesaikrishnacollections.com"
SMTP_FROM_NAME="Sree Sai Krishna Collections"
SMTP_TLS=true

# Official Meta WhatsApp Cloud API (v19.0)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v19.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="ssk_wa_verify_token_2026"
WHATSAPP_APP_SECRET=""

# Logistics Webhooks
LOGISTICS_WEBHOOK_SECRET=""
